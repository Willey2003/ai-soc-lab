# Non-secret settings for the triage service. Edit, then re-run the deploy.
# Secrets (passwords, API keys) go in secrets.env, which is git-ignored.

# Read alerts from the Wazuh indexer over the network (read-only), so nothing in
# the existing Wazuh deployment needs to change.
ALERT_SOURCE=indexer
INDEXER_URL=https://wazuh-indexer.soc-lab.svc.cluster.local:9200
INDEXER_INDEX=wazuh-alerts-4.x-*
# The lab's indexer uses its own CA. Set to true and mount the CA to verify it.
INDEXER_VERIFY_TLS=false
POLL_SECONDS=10
MIN_RULE_LEVEL=7
START_AT_END=true

# AI backends, tried left to right: ollama | hosted | heuristic
LLM_PROVIDERS=ollama,heuristic
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=90
HOSTED_API_URL=https://api.groq.com/openai/v1/chat/completions
HOSTED_MODEL=llama-3.1-8b-instant
REDACT_FOR_HOSTED=true
LOG_LEVEL=INFO
