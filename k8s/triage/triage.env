# Non-secret settings for the triage service. Edit, then re-run the deploy.
# Secrets (passwords, API keys) go in secrets.env, which is git-ignored.

# Where alerts come from:
#   simulate  replay realistic sample Wazuh alerts, one every SIMULATE_EVERY_SECONDS
#             (default: works on any cluster, no Wazuh needed)
#   indexer   read real alerts from a Wazuh indexer over the network (read-only);
#             set INDEXER_URL below and INDEXER_USER/PASSWORD in secrets.env
#   none      API only: push alerts with POST /api/triage
# Whatever you pick, real alerts can always be pushed in with POST /api/triage.
ALERT_SOURCE=simulate
SIMULATE_EVERY_SECONDS=60
INDEXER_URL=https://wazuh-indexer.soc-lab.svc.cluster.local:9200
INDEXER_INDEX=wazuh-alerts-4.x-*
# A lab indexer usually has its own CA. Set to true and mount the CA to verify it.
INDEXER_VERIFY_TLS=false
POLL_SECONDS=10
MIN_RULE_LEVEL=7
START_AT_END=true

# AI backends, tried left to right: ollama | hosted | heuristic
LLM_PROVIDERS=ollama,heuristic
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=90
HOSTED_API_URL=https://api.groq.com/openai/v1/chat/completions
HOSTED_MODEL=llama-3.1-8b-instant
REDACT_FOR_HOSTED=true
LOG_LEVEL=INFO
