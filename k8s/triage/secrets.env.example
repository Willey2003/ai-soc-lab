# Copy to secrets.env (git-ignored) and fill in. The deploy script generates
# TRIAGE_API_KEY for you if it's empty.

# A read-only indexer user. The lab already has grafana_reader.
INDEXER_USER=grafana_reader
INDEXER_PASSWORD=

# Protects the triage API and queue page
TRIAGE_API_KEY=

# Only needed if LLM_PROVIDERS includes "hosted" (free key: https://console.groq.com/keys)
HOSTED_API_KEY=
