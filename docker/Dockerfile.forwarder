FROM python:3.12-slim-bookworm

ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} wazuh-airia && \
    useradd -u ${USER_ID} -g wazuh-airia -s /usr/sbin/nologin -M wazuh-airia

WORKDIR /opt/wazuh-airia-forwarder

COPY --chown=root:root requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY --chown=root:root wazuh_airia_forwarder.py .
COPY --chown=root:root entrypoint.sh .
RUN chmod +x entrypoint.sh

USER wazuh-airia

EXPOSE 8010

ENTRYPOINT ["./entrypoint.sh"]
CMD ["python", "wazuh_airia_forwarder.py"]