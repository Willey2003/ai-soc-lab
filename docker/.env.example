# AI + SOC Lab - Environment Configuration
# Copy to .env and fill in all values
# Generate secrets with: openssl rand -hex 32

# Wazuh
WAZUH_ADMIN_PASSWORD=
WAZUH_API_PASSWORD=

# Grafana
GRAFANA_ADMIN_PASSWORD=

# Airia (get from Airia cloud console)
AIRIA_API_URL=
AIRIA_API_KEY=

# Local forwarder API key (generate: openssl rand -hex 32)
HELPER_API_KEY=

# Network
BIND_HOST=192.168.0.50
SCAN_SUBNET=192.168.0.0/24

# NetAlertX (generated after first login)
NETALERTX_API_TOKEN=

# AI triage service (triage/)
# Backends are tried left to right; heuristic always answers as a last resort.
#   ollama,heuristic          fully local and private (default)
#   hosted,heuristic          Groq free tier: fastest, but data leaves the box (redacted)
#   ollama,hosted,heuristic   local first, hosted if Ollama is down or slow
LLM_PROVIDERS=ollama,heuristic
OLLAMA_MODEL=llama3.2:3b
# Any OpenAI-compatible endpoint works. Groq free key: https://console.groq.com/keys
HOSTED_API_URL=https://api.groq.com/openai/v1/chat/completions
HOSTED_MODEL=llama-3.1-8b-instant
HOSTED_API_KEY=
REDACT_FOR_HOSTED=true
TRIAGE_MIN_RULE_LEVEL=7
# API key for the triage API/UI (generate: openssl rand -hex 32)
TRIAGE_API_KEY=
